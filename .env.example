# Copy this file to .env.local and fill in the values below.
# .env.local is gitignored — never commit real credentials.

# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Prisma / Postgres (Supabase Project Settings -> Database -> Connection string)
# DATABASE_URL: pooled connection, used by the app at request time
# DIRECT_URL: direct (non-pooled) connection, used by `prisma migrate`
DATABASE_URL=
DIRECT_URL=

# Mock data toggle (lib/config.ts) — "false" starts every module empty,
# matching a first-time user. Unset or "true" seeds demo data.
NEXT_PUBLIC_USE_DEMO_DATA=false
